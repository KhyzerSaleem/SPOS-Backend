# MongoDB connection (required)
DATABASE_URL=mongodb://localhost:27017/swiftpos

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Frontend URL (CORS + email links + OAuth redirect)
FRONTEND_URL=http://localhost:3000

# Super-admin bootstrap & emergency unlock (POST /api/auth/unlock-account)
ADMIN_SECRET=change-me-in-production

# Super-admin seed email (local .local addresses cannot receive real mail)
# Production: set to a real inbox, e.g. you@yourcompany.com
ADMIN_EMAIL=admin@swiftpos.local
SEED_ADMIN_EMAIL=admin@swiftpos.local
SEED_ADMIN_PASSWORD=Admin123!

# Demo tenant owner (db:reset only)
SEED_OWNER_EMAIL=owner@swiftpos.local
SEED_OWNER_PASSWORD=Owner123!

# Email (Brevo). When unset, OTP codes are logged to the API console in dev.
BREVO_API_KEY=
SMTP_FROM_EMAIL=noreply@swiftpos.io
SMTP_FROM_NAME=SwiftPOS

# Optional: cookie domain for cross-subdomain auth (production)
# COOKIE_DOMAIN=.swiftpos.io

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

NODE_ENV=development

# Stripe billing (optional — when unset, plan changes apply without checkout)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Allow manual change-plan while Stripe is configured (dev/staging only)
# STRIPE_ALLOW_MANUAL_CHANGE_PLAN=true

# Optional: encrypt sensitive tenant settings at rest (32+ chars recommended in production)
# ENCRYPTION_KEY=

# Optional: enables durable, retried background job processing (email delivery
# with retry/backoff + delivery tracking). Safe to leave unset — the app boots
# fine and falls back to sending inline/directly with no retry, exactly like
# before this was added. Never required at boot (unlike ENCRYPTION_KEY above).
# REDIS_URL=redis://localhost:6379
